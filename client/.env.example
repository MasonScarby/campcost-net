# Frontend (Vite) — the only vars the React client reads
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_API_URL=http://localhost:5033

# Stripe (Phase 5 — not yet wired up)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# NOTE: API-side secrets (Plaid keys, Supabase connection string, JWT config)
# do NOT belong here — set them via `dotnet user-secrets` locally and
# environment variables on Railway. See README.md.
